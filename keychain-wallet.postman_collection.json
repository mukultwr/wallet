{
  "info": {
    "name": "Keychain Wallet Service",
    "_postman_id": "keychain-wallet-service-v2",
    "description": "Prepaid Wallet Service — Keychain OS\n\n**Setup:** Run the three requests in the **Auth** folder first. Tokens are auto-saved to collection variables. Then run **Create Wallet** — the walletId is also auto-saved.\n\nAll subsequent requests use `{{adminToken}}`, `{{serviceToken}}`, or `{{customerToken}}` automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://wallet-service-production-7710.up.railway.app", "type": "string" },
    { "key": "walletId", "value": "", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "serviceToken", "value": "", "type": "string" },
    { "key": "customerToken", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Get ADMIN Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.collectionVariables.set('adminToken', json.token);",
                  "    console.log('adminToken saved');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"ADMIN-1\",\n  \"role\": \"ADMIN\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/token",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "token"]
            },
            "description": "Issues an ADMIN token. Auto-saved to `adminToken` variable. ADMIN can create wallets, topup, deduct, and read any wallet."
          },
          "response": []
        },
        {
          "name": "Get SERVICE Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.collectionVariables.set('serviceToken', json.token);",
                  "    console.log('serviceToken saved');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"ORDER-SERVICE\",\n  \"role\": \"SERVICE\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/token",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "token"]
            },
            "description": "Issues a SERVICE token for the Order Service. Auto-saved to `serviceToken`. SERVICE can topup and deduct on any wallet."
          },
          "response": []
        },
        {
          "name": "Get CUSTOMER Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.collectionVariables.set('customerToken', json.token);",
                  "    console.log('customerToken saved');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"CUST-001\",\n  \"role\": \"CUSTOMER\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/token",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "token"]
            },
            "description": "Issues a CUSTOMER token for CUST-001. Auto-saved to `customerToken`. CUSTOMER can only read their own wallet."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Wallet",
      "item": [
        {
          "name": "Create Wallet (ADMIN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.success && json.data && json.data.walletId) {",
                  "    pm.collectionVariables.set('walletId', json.data.walletId);",
                  "    console.log('walletId saved:', json.data.walletId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"CUST-001\",\n  \"name\": \"Rahul Sharma\",\n  \"email\": \"rahul@keychain.com\",\n  \"phone\": \"+919999999999\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/wallets",
              "host": ["{{baseUrl}}"],
              "path": ["wallets"]
            },
            "description": "Creates a new wallet. Requires ADMIN token. The `walletId` is auto-saved to the collection variable."
          },
          "response": []
        },
        {
          "name": "Get Balance (CUSTOMER — own wallet)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/wallets/{{walletId}}/balance",
              "host": ["{{baseUrl}}"],
              "path": ["wallets", "{{walletId}}", "balance"]
            },
            "description": "Returns balance. CUSTOMER token only works if the wallet's customerId matches the token's customerId (CUST-001)."
          },
          "response": []
        },
        {
          "name": "Get Transaction History (CUSTOMER — own wallet)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/wallets/{{walletId}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["wallets", "{{walletId}}", "transactions"]
            },
            "description": "Returns full immutable ledger. CUSTOMER can only see their own wallet."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Top Up",
      "item": [
        {
          "name": "Top Up ₹500 (SERVICE)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{serviceToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 500\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/wallets/{{walletId}}/topup",
              "host": ["{{baseUrl}}"],
              "path": ["wallets", "{{walletId}}", "topup"]
            },
            "description": "Add ₹500 to the wallet. Requires SERVICE or ADMIN token."
          },
          "response": []
        },
        {
          "name": "Top Up ₹100 (SERVICE)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{serviceToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 100\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/wallets/{{walletId}}/topup",
              "host": ["{{baseUrl}}"],
              "path": ["wallets", "{{walletId}}", "topup"]
            },
            "description": "Top up exactly ₹100 — enough for exactly one deduction."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Deduct",
      "item": [
        {
          "name": "Deduct ₹100 — ORDER-001 (SERVICE)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{serviceToken}}" },
              { "key": "Idempotency-Key", "value": "ORDER-001", "description": "Required — unique per order" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"referenceId\": \"ORDER-001\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/wallets/{{walletId}}/deduct",
              "host": ["{{baseUrl}}"],
              "path": ["wallets", "{{walletId}}", "deduct"]
            },
            "description": "Deducts ₹100 for ORDER-001. Requires SERVICE token."
          },
          "response": []
        },
        {
          "name": "Deduct ₹100 — ORDER-001 (idempotency retry)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{serviceToken}}" },
              { "key": "Idempotency-Key", "value": "ORDER-001", "description": "Same key — must return same transactionId, wallet NOT double-charged" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"referenceId\": \"ORDER-001\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/wallets/{{walletId}}/deduct",
              "host": ["{{baseUrl}}"],
              "path": ["wallets", "{{walletId}}", "deduct"]
            },
            "description": "Retry with same Idempotency-Key. Must return identical transactionId — proves no double charge."
          },
          "response": []
        },
        {
          "name": "Deduct ₹100 — ORDER-002 (SERVICE)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{serviceToken}}" },
              { "key": "Idempotency-Key", "value": "ORDER-002" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"referenceId\": \"ORDER-002\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/wallets/{{walletId}}/deduct",
              "host": ["{{baseUrl}}"],
              "path": ["wallets", "{{walletId}}", "deduct"]
            },
            "description": "A separate order with a different idempotency key."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Error Cases",
      "item": [
        {
          "name": "Get Balance — Wrong Customer (403)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/wallets/some-other-wallet-id/balance",
              "host": ["{{baseUrl}}"],
              "path": ["wallets", "some-other-wallet-id", "balance"]
            },
            "description": "CUSTOMER token for CUST-001 trying to read a wallet that belongs to a different customer. Expects HTTP 403."
          },
          "response": []
        },
        {
          "name": "Deduct — No Token (401)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "ORDER-NOAUTH" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"referenceId\": \"ORDER-NOAUTH\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/wallets/{{walletId}}/deduct",
              "host": ["{{baseUrl}}"],
              "path": ["wallets", "{{walletId}}", "deduct"]
            },
            "description": "No Authorization header. Expects HTTP 401."
          },
          "response": []
        },
        {
          "name": "Deduct — Insufficient Balance (422)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{serviceToken}}" },
              { "key": "Idempotency-Key", "value": "ORDER-BROKE-001" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"referenceId\": \"ORDER-BROKE-001\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/wallets/{{walletId}}/deduct",
              "host": ["{{baseUrl}}"],
              "path": ["wallets", "{{walletId}}", "deduct"]
            },
            "description": "Run on a wallet with balance < ₹100. Expects HTTP 422."
          },
          "response": []
        },
        {
          "name": "Deduct — Missing Idempotency-Key (400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{serviceToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"referenceId\": \"ORDER-003\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/wallets/{{walletId}}/deduct",
              "host": ["{{baseUrl}}"],
              "path": ["wallets", "{{walletId}}", "deduct"]
            },
            "description": "No Idempotency-Key header. Expects HTTP 400."
          },
          "response": []
        },
        {
          "name": "Get Balance — Wallet Not Found (404)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/wallets/nonexistent-wallet-id/balance",
              "host": ["{{baseUrl}}"],
              "path": ["wallets", "nonexistent-wallet-id", "balance"]
            },
            "description": "Expects HTTP 404."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": ["{{baseUrl}}"],
              "path": ["actuator", "health"]
            },
            "description": "Open — no auth required. Returns status of PostgreSQL, MongoDB, disk."
          },
          "response": []
        }
      ]
    }
  ]
}
