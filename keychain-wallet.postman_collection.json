{
  "info": {
    "name": "Keychain Wallet Service",
    "_postman_id": "keychain-wallet-service-v1",
    "description": "Prepaid Wallet Service — Keychain OS\n\nBase URL is stored as a collection variable. After running **Create Wallet**, the wallet ID is automatically saved to `walletId` so every subsequent request uses it without manual copy-paste.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://wallet-service-production-7710.up.railway.app",
      "type": "string"
    },
    {
      "key": "walletId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Wallet",
      "item": [
        {
          "name": "Create Wallet",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.success && json.data && json.data.walletId) {",
                  "    pm.collectionVariables.set('walletId', json.data.walletId);",
                  "    console.log('walletId saved:', json.data.walletId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"CUST-001\",\n  \"name\": \"Rahul Sharma\",\n  \"email\": \"rahul@keychain.com\",\n  \"phone\": \"+919999999999\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/wallets",
              "host": ["{{baseUrl}}"],
              "path": ["wallets"]
            },
            "description": "Creates a new wallet. The `walletId` from the response is automatically saved to the collection variable and used by all subsequent requests."
          },
          "response": []
        },
        {
          "name": "Get Balance",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/wallets/{{walletId}}/balance",
              "host": ["{{baseUrl}}"],
              "path": ["wallets", "{{walletId}}", "balance"]
            },
            "description": "Returns the current balance in both INR and paise."
          },
          "response": []
        },
        {
          "name": "Get Transaction History",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/wallets/{{walletId}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["wallets", "{{walletId}}", "transactions"]
            },
            "description": "Returns the full immutable ledger for this wallet, newest first."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Top Up",
      "item": [
        {
          "name": "Top Up ₹500",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 500\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/wallets/{{walletId}}/topup",
              "host": ["{{baseUrl}}"],
              "path": ["wallets", "{{walletId}}", "topup"]
            },
            "description": "Add ₹500 to the wallet."
          },
          "response": []
        },
        {
          "name": "Top Up ₹100 (exact threshold)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 100\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/wallets/{{walletId}}/topup",
              "host": ["{{baseUrl}}"],
              "path": ["wallets", "{{walletId}}", "topup"]
            },
            "description": "Top up exactly ₹100 — enough for exactly one deduction."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Deduct",
      "item": [
        {
          "name": "Deduct ₹100 — ORDER-001",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "ORDER-001", "description": "Required — unique per order" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"referenceId\": \"ORDER-001\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/wallets/{{walletId}}/deduct",
              "host": ["{{baseUrl}}"],
              "path": ["wallets", "{{walletId}}", "deduct"]
            },
            "description": "Deducts ₹100 for order ORDER-001."
          },
          "response": []
        },
        {
          "name": "Deduct ₹100 — ORDER-001 (idempotency retry)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "ORDER-001", "description": "Same key as above — should return the same transactionId, wallet NOT double-charged" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"referenceId\": \"ORDER-001\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/wallets/{{walletId}}/deduct",
              "host": ["{{baseUrl}}"],
              "path": ["wallets", "{{walletId}}", "deduct"]
            },
            "description": "Sends the exact same Idempotency-Key as the previous request. The response must have the same transactionId — proving the wallet was only charged once."
          },
          "response": []
        },
        {
          "name": "Deduct ₹100 — ORDER-002",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "ORDER-002" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"referenceId\": \"ORDER-002\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/wallets/{{walletId}}/deduct",
              "host": ["{{baseUrl}}"],
              "path": ["wallets", "{{walletId}}", "deduct"]
            },
            "description": "A second, separate order with a different idempotency key."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Error Cases",
      "item": [
        {
          "name": "Deduct — Insufficient Balance (422)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "ORDER-BROKE-001" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"referenceId\": \"ORDER-BROKE-001\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/wallets/{{walletId}}/deduct",
              "host": ["{{baseUrl}}"],
              "path": ["wallets", "{{walletId}}", "deduct"]
            },
            "description": "Run this on a wallet with balance < ₹100. Expects HTTP 422 with a clear error message."
          },
          "response": []
        },
        {
          "name": "Deduct — Missing Idempotency-Key (400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"referenceId\": \"ORDER-003\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/wallets/{{walletId}}/deduct",
              "host": ["{{baseUrl}}"],
              "path": ["wallets", "{{walletId}}", "deduct"]
            },
            "description": "No Idempotency-Key header. Expects HTTP 400."
          },
          "response": []
        },
        {
          "name": "Get Balance — Wallet Not Found (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/wallets/nonexistent-wallet-id/balance",
              "host": ["{{baseUrl}}"],
              "path": ["wallets", "nonexistent-wallet-id", "balance"]
            },
            "description": "Expects HTTP 404 with a clear error message."
          },
          "response": []
        },
        {
          "name": "Create Wallet — Validation Error (400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"CUST-002\",\n  \"name\": \"\",\n  \"email\": \"not-an-email\",\n  \"phone\": \"+91\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/wallets",
              "host": ["{{baseUrl}}"],
              "path": ["wallets"]
            },
            "description": "Invalid email and blank name. Expects HTTP 400 with field-level validation errors."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": ["{{baseUrl}}"],
              "path": ["actuator", "health"]
            },
            "description": "Returns status of all components: PostgreSQL, MongoDB, disk."
          },
          "response": []
        }
      ]
    }
  ]
}
